{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"]
  },
  "include": [
    "scripts/**/*",
    "lib/**/*",
    "index.ts",
    "__tests__/**/*",
    "__mocks__/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
