# Dependencies
node_modules/
# Build artifacts
dist/
build/

# Local environment variables
.env.local
.env.local.example

#unwanted files
final_dapps.rewritten.json

# Generated runtime indexes
build/apps.min.json
build/facets.index.json

# Internal setup documentation (not for public repo)
.github/BRANCH_PROTECTION.md
.github/scripts/

.claude

# Resource discovery scratch: the fetch cache holds one file per crawled URL
# (tens of thousands, >1GB) and every file in it is regenerable by re-running
# fetch-resources.ts.
data/.resource-cache/
data/_*.json
data/_*.txt
data/_*.log
data/target-slugs*.txt

# Crawl output and curation working files. The published data lives in each
# app's meta.json; these are inputs and reports that can all be regenerated
# from the scripts, so they stay out of the repo.
data/resource-candidates.json
data/resource-candidates-b.json
data/resource-candidates-c.json
data/resource-candidates-pool.json
data/editorial-candidates.json
data/resource-selections.json
data/resources-new-100.json
data/resources-third-batch-100.json
data/resources-third-batch.json
data/resources-added.json
data/selections/

# One-off local helper scripts used during resource curation.
scripts/apply-tldr-patch.ts
scripts/check-resource-links.ts
scripts/enrich-resources.ts
scripts/export-new-batch.ts
scripts/fetch-resource-images.ts
scripts/probe-article-tags.ts
data/resources-batch4-100.json
data/resources-fourth-batch-100.json
data/resources-fifth-batch-100.json
data/resources-first-batch-100.json
